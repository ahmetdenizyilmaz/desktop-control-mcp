# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.venv/
venv/
env/

# Runtime state
.lock.json
.claude-gui-images/

# Screenshots and captured images (not part of source)
screenshots/
test/
*.png
*.jpg
*.jpeg
!templates/*.png
!templates/*.jpg
!assets/*.png
!assets/*.jpg

# Local debug / scratch scripts (CDP scripts for unrelated Tauri project)
cdp_*.py

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# agent/ — the desktop agent. Source is tracked; none of the below is.
# ---------------------------------------------------------------------------

# Credentials. vault.json is the DPAPI secret store, .daemon-token is a live
# token. Neither belongs in history, encrypted or not.
agent/vault.json
agent/.daemon-token

# Browser session state: cookies, logins, 61MB of Chromium profile.
agent/browser_profile/
agent/downloads/

# Scratch output — images, logs, whatever a task happened to write. 788MB.
agent/workspace/
agent/@AutomationLog.txt

# Per-machine runtime data, not source. paths.py already treats these as user
# data, and machine_profile.json is meaningless on another PC.
agent/lessons.json
agent/machine_profile.json
agent/schedules.json
agent/settings.json
agent/macros/

# Learned caches — remembered selectors and which sites needed a headed
# browser. They rebuild themselves, and they record where this PC has been.
agent/browser_flows.json
agent/browser_sites.json

# A page captured for a one-off parse.
agent/bist30page.html
agent/bist30page_files/

# Build artefacts and the local LiteLLM venv at the repo root.
build/
dist/
litellm-venv/

# Jev decision journals.
agent/logs/

# More per-machine agent state: Telegram/mail pairing, learned cost rates,
# engine run checkpoints and per-script run stats.
agent/channel.json
agent/token_rates.json
agent/runs/
agent/script_stats.json

# ---------------------------------------------------------------------------
# pipeline/ — source and scripts are tracked; run output is not.
# ---------------------------------------------------------------------------
# Screen recordings (tens of MB each, and they show the desktop).
pipeline/recordings/
# Screenshots handed to Opus when a step was stuck.
pipeline/.stuck/
# Fetched remote scripts, deleted scripts.
pipeline/script/.cache/
pipeline/script/scripts/.trash/
