{
  "name": "whatsapp/say",
  "version": 1,
  "description": "Send one message in the open chat.",
  "params": {
    "message": ""
  },
  "trust": "draft",
  "steps": [
    {
      "do": "type",
      "into": {
        "text": "Type a message",
        "kind": "edit"
      },
      "value": "{message}",
      "then": "enter"
    },
    {
      "do": "wait",
      "seconds": 0.6
    }
  ]
}
